# Luma V2 Environment Variables
# Copy to .env (or apps/web/.env.local & apps/realtime/.env) for custom deployment

# Web & Realtime URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_REALTIME_URL=http://localhost:4001
PORT=3000
REALTIME_PORT=4001
CORS_ORIGIN=http://localhost:3000

# Security & Session Signing (change in production!)
SESSION_SECRET=luma-dev-session-secret-change-in-production-32chars

# Local SQLite Database Path (zero-setup default using Node 24 node:sqlite)
LUMA_DB_PATH=./data/luma.db

# Optional PostgreSQL / Supabase (for cloud production deployment)
# DATABASE_URL=postgresql://user:password@host:5432/luma
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Optional LiveKit SFU for large-scale rooms (WebRTC P2P Mesh + Web Audio 3D works out-of-the-box without keys)
# LIVEKIT_URL=
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=

# Optional TURN Server for strict NAT traversal in WebRTC
# NEXT_PUBLIC_TURN_URL=
# NEXT_PUBLIC_TURN_USERNAME=
# NEXT_PUBLIC_TURN_CREDENTIAL=
